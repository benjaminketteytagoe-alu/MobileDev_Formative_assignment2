rules_version = '2';

// Access control for the Campus Incident Reporter.
//
// Roles
//   student : any signed-in user whose user document has role "student".
//   staff   : role "staff" in the user document AND an
//             @alueducation.com email address. Both conditions are checked
//             server-side, so changing the app code cannot grant staff rights.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function hasStaffEmail() {
      return tokenEmail().matches('.*@alueducation[.]com');
    }

    function hasStudentEmail() {
      return tokenEmail().matches('.*@alustudent[.]com');
    }

    // An ALU account. Everything except a user's own profile needs this, so
    // an outside account can read nothing.
    function isMember() {
      return signedIn()
        && (hasStudentEmail() || hasStaffEmail());
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && hasStaffEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'staff';
    }

    function validCategory(c) {
      return c in ['facility', 'water', 'electricity', 'furniture', 'sanitation', 'safety'];
    }

    function validSector(s) {
      return s in ['social_commons', 'enterprise_commons', 'leadership_centre', 'collaboration_street'];
    }

    function validStatus(s) {
      return s in ['submitted', 'in_review', 'in_progress', 'resolved', 'rejected'];
    }

    function validUrgency(u) {
      return u in ['low', 'medium', 'high'];
    }

    // Returns true if newStatus is a valid transition from oldStatus.
    // The rules language has no if statements, so this is one expression.
    // resolved and rejected are terminal.
    function validTransition(oldStatus, newStatus) {
      return (oldStatus == 'submitted' && newStatus in ['in_review', 'rejected'])
        || (oldStatus == 'in_review' && newStatus in ['in_progress', 'rejected'])
        || (oldStatus == 'in_progress' && newStatus in ['resolved', 'rejected']);
    }

    function nonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // A user may only create their own profile, always as a student. Nobody
      // proves they own their address, so staff are promoted by hand in the
      // Firebase console, and isStaff() also needs an @alueducation.com email.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'reportsSubmitted', 'createdAt'])
        && nonEmptyString(request.resource.data.name, 100)
        && request.resource.data.email.lower() == tokenEmail()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.role == 'student'
        && (hasStudentEmail() || hasStaffEmail());

      // Only the display name can be changed. The role is fixed.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'reportsSubmitted'])
        && nonEmptyString(request.resource.data.name, 100);

      allow delete: if false;

      // ------------------------------------------------------- drafts
      // An unsent report the user chose to keep. Private to its owner.
      // Photo paths point at files on the owner's phone, not at Storage.
      match /drafts/{draftId} {
        allow read, delete: if isMember() && request.auth.uid == uid;
        allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
               'title', 'description', 'category', 'sector', 'locationDetail',
               'urgency', 'anonymous', 'localImagePaths', 'updatedAt'
             ])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.locationDetail is string
          && request.resource.data.locationDetail.size() <= 150
          && request.resource.data.localImagePaths is list
          && request.resource.data.localImagePaths.size() <= 5
          && request.resource.data.updatedAt is timestamp;
      }
    }

    // ------------------------------------------------------------ incidents
    match /incidents/{incidentId} {
      allow read: if isMember();

      // True when this write also deletes the report. Sub-collections can only
      // be removed this way, so history stays append-only otherwise.
      function reportBeingDeleted() {
        return !existsAfter(/databases/$(database)/documents/incidents/$(incidentId));
      }

      // An anonymous report must store the placeholder, not a real name.
      function validReporterName(data) {
        return data.get('anonymous', false) is bool
          && (data.get('anonymous', false) == false
              || data.reporterName == 'Anonymous student');
      }

      // Any member can file a report in their own name. New reports
      // always start as "submitted".
      allow create: if isMember()
        && request.resource.data.keys().hasOnly([
             'title', 'description', 'category', 'location', 'sector', 'urgency', 'status',
             'reporterId', 'reporterName', 'anonymous', 'images', 'searchKeywords',
             'upvoteCount', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.reporterId == request.auth.uid
        && validReporterName(request.resource.data)
        && request.resource.data.status == 'submitted'
        && nonEmptyString(request.resource.data.title, 120)
        && nonEmptyString(request.resource.data.description, 2000)
        && nonEmptyString(request.resource.data.location, 200)
        && validCategory(request.resource.data.category)
        && validSector(request.resource.data.sector)
        && validUrgency(request.resource.data.urgency)
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && request.resource.data.searchKeywords is list
        && request.resource.data.upvoteCount == 0
        && request.resource.data.createdAt is timestamp;

      // Owner can edit their own report only while status is "submitted".
      // They cannot change status, reporterId, reporterName, or images.
      function ownerEdit() {
        return isMember()
          && request.auth.uid == resource.data.reporterId
          && resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'description', 'category', 'location', 'sector', 'urgency',
               'searchKeywords', 'updatedAt'
             ])
          && nonEmptyString(request.resource.data.title, 120)
          && nonEmptyString(request.resource.data.description, 2000)
          && nonEmptyString(request.resource.data.location, 200)
          && validCategory(request.resource.data.category)
          && validSector(request.resource.data.sector)
          && validUrgency(request.resource.data.urgency);
      }

      // Staff can change status, assignedTo, resolvedAt, and updatedAt.
      function staffUpdate() {
        return isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'assignedTo', 'assignedToName', 'updatedAt', 'resolvedAt'
             ])
          && validStatus(request.resource.data.status)
          && validTransition(resource.data.status, request.resource.data.status);
      }

      // Staff can assign a report to themselves without changing its status.
      function staffAssign() {
        return isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'assignedTo', 'assignedToName', 'updatedAt'
             ])
          && request.resource.data.assignedTo == request.auth.uid
          && nonEmptyString(request.resource.data.assignedToName, 100);
      }

      // Any member can move upvoteCount by exactly one, and only in
      // the same transaction that creates or deletes their own vote document.
      function voteCountUpdate() {
        let voteDoc = /databases/$(database)/documents/incidents/$(incidentId)/votes/$(request.auth.uid);
        let delta = request.resource.data.upvoteCount - resource.data.upvoteCount;
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount'])
          && request.resource.data.upvoteCount is int
          && (
            (delta == 1 && !exists(voteDoc) && existsAfter(voteDoc))
            || (delta == -1 && exists(voteDoc) && !existsAfter(voteDoc))
          );
      }

      allow update: if ownerEdit() || staffUpdate() || staffAssign() || voteCountUpdate();

      // Owner can delete only when status is "submitted", or staff can delete.
      allow delete: if isStaff()
        || (isMember()
            && request.auth.uid == resource.data.reporterId
            && resource.data.status == 'submitted');

      // -------------------------------------------------------- history
      match /history/{entryId} {
        allow read: if isMember();
        // Staff record status changes. The reporter may write only the first
        // "submitted" entry, in the same batch that creates the report
        // (getAfter sees the report as it will be once the batch commits).
        allow create: if isMember()
          && request.resource.data.keys().hasOnly([
               'fromStatus', 'toStatus', 'byUid', 'byName', 'note', 'at'
             ])
          && request.resource.data.byUid == request.auth.uid
          && validStatus(request.resource.data.toStatus)
          && nonEmptyString(request.resource.data.byName, 100)
          && request.resource.data.at is timestamp
          && (
            (isStaff() && validStatus(request.resource.data.fromStatus))
            || (request.resource.data.fromStatus == ''
                && request.resource.data.toStatus == 'submitted'
                && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.reporterId == request.auth.uid)
          );
        allow update: if false;
        allow delete: if isMember() && reportBeingDeleted();
      }

      // ---------------------------------------------------------- votes
      match /votes/{voterUid} {
        allow read: if isMember();
        // A user can create only their own vote document.
        allow create: if isMember()
          && request.auth.uid == voterUid
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is timestamp;
        // A user can delete only their own vote, unless the report is going.
        allow delete: if isMember()
          && (request.auth.uid == voterUid || reportBeingDeleted());
        allow update: if false;
      }

      // ---------------------------------------------------------- flags
      // One "false or abusive" flag per person. Flaggers stay private: only
      // staff can see them, and a user can see their own.
      match /flags/{flaggerUid} {
        allow read: if isStaff() || (isMember() && request.auth.uid == flaggerUid);
        allow create: if isMember()
          && request.auth.uid == flaggerUid
          && request.auth.uid != get(/databases/$(database)/documents/incidents/$(incidentId)).data.reporterId
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at is timestamp;
        allow update: if false;
        allow delete: if isStaff() && reportBeingDeleted();
      }
    }

    // ------------------------------------------------------- notifications
    match /notifications/{notificationId} {
      // Users can read only their own notifications.
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      // Staff can create notifications (e.g., on status change).
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
             'userId', 'message', 'incidentId', 'read', 'at'
           ])
        && nonEmptyString(request.resource.data.userId, 100)
        && nonEmptyString(request.resource.data.message, 500)
        && request.resource.data.read == false
        && request.resource.data.at is timestamp;
      // Users can update only their own notifications (mark as read).
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}
